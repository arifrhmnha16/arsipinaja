# ==========================================
# ARSIPINAJA ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Firebase Authentication & Cloud Firestore
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=arsipinaja-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=arsipinaja-prod
VITE_FIREBASE_STORAGE_BUCKET=arsipinaja-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 2. Cloudflare R2 Storage Worker API
# Endpoint worker yang menghandle upload, download, and file access
VITE_CLOUDFLARE_WORKER_URL=https://arsipinaja-storage-worker.your-account.workers.dev

# 3. Telegram Bot API
# Nama username bot dan token bot dari @BotFather
VITE_TELEGRAM_BOT_USERNAME=ArsipinAjaBot
VITE_TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# 4. Regional Timezone
VITE_DEFAULT_TIMEZONE=Asia/Jakarta
